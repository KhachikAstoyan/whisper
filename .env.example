#!/usr/bin/env bash
# Copy to .env and fill in values, then: source .env

# --- server ---
export SERVER_PORT=8080
export DATABASE_URL=postgres://postgres:postgres@localhost:5432/whisper?sslmode=disable
export STORAGE_PATH=./storage
export JWT_SECRET=change-me-to-a-long-random-secret
export ENV=dev

# --- client ---
export SERVER_URL=http://localhost:8080
